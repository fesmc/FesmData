# AWI Albedo. Source from the FesmData root:  source shared/machines/albedo.env
# Used to download the released products (fesmdata.jl fetch/mirror), which needs only
# ICE_DATA and the Julia standard library. $FORCLIMA is set by the albedo environment.

[ -n "$FORCLIMA" ] || echo "FORCLIMA is not set" >&2
export ICE_DATA=$FORCLIMA/ice_data
