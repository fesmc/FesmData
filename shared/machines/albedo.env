# AWI Albedo (project p_forclima). Source from the FesmData root before running
# scripts, submitting jobs or downloading products (fesmdata.jl fetch/mirror):
#     source shared/machines/albedo.env
# $FORCLIMA is set by the Albedo login environment. Julia from juliaup
# (`juliaup add 1.13.1`).

export FESMDATA_MACHINE=albedo
export PATH="$HOME/.juliaup/bin:$PATH"
export JULIAUP_CHANNEL=1.13.1

# Storage (see shared/machines/README.md): the products ($FESMDATA), sources and prepared
# sources of the project in sibling folders in $FORCLIMA, writable by the group
# p_forclima; intermediate files per user on /albedo/scratch. Each can be set before
# sourcing.
[ -n "$FORCLIMA" ] || echo "FORCLIMA is not set" >&2
export FESMDATA=${FESMDATA:-$FORCLIMA/fesmdata}
export FESMDATA_SOURCES=${FESMDATA_SOURCES:-$FESMDATA-sources}
export FESMDATA_PREPARED=${FESMDATA_PREPARED:-$FESMDATA-prepared}
export FESMDATA_WORK=${FESMDATA_WORK:-/albedo/scratch/user/$USER/fesmdata-work}
# v1 products, compared with in the plots of Topo step 5
export FESMDATA_V1=${FESMDATA_V1:-$FORCLIMA/ice_data}

# Slurm: account, partition (full nodes) and QOS of the jobs (the default QOS allows
# only 30 min; 12h: up to 12 h)
export SBATCH_ACCOUNT=${SBATCH_ACCOUNT:-envi.p_forclima}
export SBATCH_PARTITION=${SBATCH_PARTITION:-mpp}
export SBATCH_QOS=${SBATCH_QOS:-12h}

# Tokens for Publish, kept outside the repository (see levante.env)
if [ -f ~/.gitlab_token ]; then export GITLAB_TOKEN=$(cat ~/.gitlab_token); fi
if [ -f ~/.zenodo_token ]; then export ZENODO_TOKEN=$(cat ~/.zenodo_token); fi
if [ -f ~/.zenodo_sandbox_token ]; then export ZENODO_SANDBOX_TOKEN=$(cat ~/.zenodo_sandbox_token); fi
