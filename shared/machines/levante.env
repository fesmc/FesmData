# DKRZ Levante (project ba1442). Source from the FesmData root before running
# scripts or submitting jobs:  source shared/machines/levante.env

export PATH="$HOME/.juliaup/bin:$PATH"
export JULIAUP_CHANNEL=1.13.1

# Original datasets (DataManifest), processed output, intermediate files
export DATAMANIFEST_DATASETS_DIR=/work/ba1442/data
export ICE_DATA=/work/ba1442/ice_data
export FESMDATA_WORK=/work/ba1442/fesmdata/work

# Account used by sbatch
export SBATCH_ACCOUNT=ba1442

# Tokens for Publish, kept outside the repository: GitLab (scope api) in
# ~/.gitlab_token; Zenodo (scopes deposit:write, deposit:actions) in ~/.zenodo_token
# and ~/.zenodo_sandbox_token
if [ -f ~/.gitlab_token ]; then export GITLAB_TOKEN=$(cat ~/.gitlab_token); fi
if [ -f ~/.zenodo_token ]; then export ZENODO_TOKEN=$(cat ~/.zenodo_token); fi
if [ -f ~/.zenodo_sandbox_token ]; then export ZENODO_SANDBOX_TOKEN=$(cat ~/.zenodo_sandbox_token); fi
