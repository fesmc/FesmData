# DKRZ Levante (project ba1442). Source from the FesmData root before running
# scripts or submitting jobs:  source shared/machines/levante.env

export FESMDATA_MACHINE=levante
export PATH="$HOME/.juliaup/bin:$PATH"
export JULIAUP_CHANNEL=1.13.1

# Storage (see shared/machines/README.md): the sources, prepared sources and products of the
# project on /work, writable by the group ba1442; intermediate files per user on
# /scratch (deleted 14 days after their last access). Each can be set before sourcing.
export FESMDATA=${FESMDATA:-/work/ba1442/fesmdata}
export FESMDATA_SOURCES=${FESMDATA_SOURCES:-$FESMDATA/sources}
export FESMDATA_PREPARED=${FESMDATA_PREPARED:-$FESMDATA/prepared}
export FESMDATA_PRODUCTS=${FESMDATA_PRODUCTS:-$FESMDATA/products}
export FESMDATA_WORK=${FESMDATA_WORK:-/scratch/${USER:0:1}/$USER/fesmdata}
# v1 products, compared with in the plots of Topo step 5
export FESMDATA_V1=${FESMDATA_V1:-/work/ba1442/ice_data}

# Slurm: account and partition (full nodes) of the jobs
export SBATCH_ACCOUNT=${SBATCH_ACCOUNT:-ba1442}
export SBATCH_PARTITION=${SBATCH_PARTITION:-compute}

# Tokens for Publish, kept outside the repository: Helmholtz Codebase (GitLab, scope
# api) in ~/.gitlab_token; Zenodo (scopes deposit:write, deposit:actions) in
# ~/.zenodo_token and ~/.zenodo_sandbox_token
if [ -f ~/.gitlab_token ]; then export GITLAB_TOKEN=$(cat ~/.gitlab_token); fi
if [ -f ~/.zenodo_token ]; then export ZENODO_TOKEN=$(cat ~/.zenodo_token); fi
if [ -f ~/.zenodo_sandbox_token ]; then export ZENODO_SANDBOX_TOKEN=$(cat ~/.zenodo_sandbox_token); fi
