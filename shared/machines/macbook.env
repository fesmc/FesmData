# Local laptop. Source from the FesmData root:  source shared/machines/macbook.env

export DATAMANIFEST_DATASETS_DIR=$HOME/models/fesmdata_sources
export ICE_DATA=$HOME/models/ice_data
export FESMDATA_WORK=$HOME/models/fesmdata_work
export JULIA_NUM_THREADS=8

# Tokens for Publish, kept outside the repository: GitLab (scope api) in
# ~/.gitlab_token; Zenodo (scopes deposit:write, deposit:actions) in ~/.zenodo_token
# and ~/.zenodo_sandbox_token
if [ -f ~/.gitlab_token ]; then export GITLAB_TOKEN=$(cat ~/.gitlab_token); fi
if [ -f ~/.zenodo_token ]; then export ZENODO_TOKEN=$(cat ~/.zenodo_token); fi
if [ -f ~/.zenodo_sandbox_token ]; then export ZENODO_SANDBOX_TOKEN=$(cat ~/.zenodo_sandbox_token); fi
